                <mxCell id="arrow_rg_law" parent="lz_box" source="m_rg" target="m_law" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0078D4;strokeWidth=2;">
