                <mxCell id="m_vm" value="azurerm_linux_virtual_machine&lt;br&gt;&lt;small&gt;(Enterprise Workload Instance)&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FF8C00;strokeColor=#D13438;fontColor=#ffffff;fontStyle=1;fontSize=13;" parent="tier4_box" vertex="1">
