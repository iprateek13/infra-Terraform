                <mxCell id="m_nic" value="azurerm_network_interface&lt;br&gt;&lt;small&gt;(Network Adapter Card)&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#008272;strokeColor=#004D40;fontColor=#ffffff;fontStyle=1;" parent="tier4_box" vertex="1">
