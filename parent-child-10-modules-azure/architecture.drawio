                    <mxGeometry x="30" y="320" width="910" height="230" as="geometry"/>
                </mxCell>
                <mxCell id="m_vnet" value="azurerm_virtual_network&lt;br&gt;&lt;small&gt;(Hub/Spoke VNet Space)&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#5C2D91;strokeColor=#3B1470;fontColor=#ffffff;fontStyle=1;" parent="tier3_box" vertex="1">
