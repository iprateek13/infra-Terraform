<mxfile host="65bd71144e">
    <diagram id="azure-landing-zone-architecture" name="Azure Landing Zone Resource Flow">
        <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="950" background="#ffffff" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
