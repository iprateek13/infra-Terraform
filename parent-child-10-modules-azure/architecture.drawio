                    <mxGeometry x="20" y="580" width="240" height="80" as="geometry"/>
                </mxCell>

                <!-- Right Container: Azure Landing Zone Child Modules & Flow -->
                <mxCell id="lz_box" value="Azure Landing Zone Child Modules (4-Tier Architectural Flow)" style="shape=swimlane;whiteSpace=wrap;html=1;startSize=30;horizontal=1;fillColor=#E1F5FE;strokeColor=#0288D1;strokeWidth=2;fontStyle=1;fontSize=15;fontColor=#01579B;" parent="root_box" vertex="1">
                    <mxGeometry x="340" y="60" width="970" height="790" as="geometry"/>
